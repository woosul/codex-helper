diff --git a/Tests/KakaoCoreTests/AccountRecoveryTests.swift b/Tests/KakaoCoreTests/AccountRecoveryTests.swift
new file mode 100644
index 0000000..d0cba97
--- /dev/null
+++ b/Tests/KakaoCoreTests/AccountRecoveryTests.swift
@@ -0,0 +1,67 @@
+import CommonCrypto
+import Foundation
+import Testing
+@testable import KakaoCore
+
+private func accountHash(_ id: Int) -> String {
+    let bytes = Array(String(id).utf8)
+    var hash = [UInt8](repeating: 0, count: 64)
+    CC_SHA512(bytes, CC_LONG(bytes.count), &hash)
+    return hash.map { String(format: "%02x", $0) }.joined()
+}
+
+@Test func recoveryHandlesDecimalCarriesAndWorkerBoundaries() {
+    for id in [0, 9, 10, 99, 100, 332, 333, 334, 999] {
+        #expect(DeviceInfo.recoverUserIdFromSHA512(
+            hexHash: accountHash(id), maxId: 1000, timeoutSeconds: 2, workerCount: 3
+        ) == id)
+    }
+    #expect(DeviceInfo.recoverUserIdFromSHA512(
+        hexHash: accountHash(1000), maxId: 1000, timeoutSeconds: 2, workerCount: 3
+    ) == nil)
+}
+
+@Test func recoveryRejectsMalformedHashAndHonorsDeadline() {
+    #expect(DeviceInfo.recoverUserIdFromSHA512(hexHash: String(repeating: "z", count: 128)) == nil)
+    #expect(DeviceInfo.recoverUserIdFromSHA512(
+        hexHash: accountHash(999_999), maxId: 1_000_000, timeoutSeconds: 0, workerCount: 1
+    ) == nil)
+}
+
+@Test func accountCacheSkipsSearchAndInvalidatesOnAccountSwitch() throws {
+    let dir = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+    defer { try? FileManager.default.removeItem(at: dir) }
+    let file = dir.appendingPathComponent("account.json")
+    var searches = 0
+    let first = DeviceInfo.resolveAccountUserId(hash: accountHash(123), cacheURL: file) { _ in
+        searches += 1
+        return 123
+    }
+    #expect(first == 123)
+    #expect(searches == 1)
+    #expect(DeviceInfo.resolveAccountUserId(hash: accountHash(123), cacheURL: file) { _ in
+        searches += 1
+        return nil
+    } == 123)
+    #expect(searches == 1)
+    #expect(DeviceInfo.resolveAccountUserId(hash: accountHash(456), cacheURL: file) { _ in
+        searches += 1
+        return 456
+    } == 456)
+    #expect(searches == 2)
+    let permissions = try FileManager.default.attributesOfItem(atPath: file.path)[.posixPermissions] as? NSNumber
+    #expect(permissions?.intValue == 0o600)
+    let cache = try JSONSerialization.jsonObject(with: Data(contentsOf: file)) as? [String: Any]
+    #expect(Set(cache?.keys.map { $0 } ?? []) == Set(["accountHash", "userId"]))
+}
+
+@Test func accountCacheDoesNotTrustMismatchedOrCorruptValues() throws {
+    let dir = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+    defer { try? FileManager.default.removeItem(at: dir) }
+    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+    let file = dir.appendingPathComponent("account.json")
+    try JSONSerialization.data(withJSONObject: ["accountHash": accountHash(123), "userId": 456]).write(to: file)
+    #expect(DeviceInfo.resolveAccountUserId(hash: accountHash(123), cacheURL: file) { _ in 123 } == 123)
+    try Data("invalid".utf8).write(to: file)
+    #expect(DeviceInfo.resolveAccountUserId(hash: accountHash(123), cacheURL: file) { _ in 456 } == nil)
+}
