+    private struct AccountCache: Codable {
+        let accountHash: String
+        let userId: Int
+    }
+
+    private static func matchesAccount(_ id: Int, hash: String) -> Bool {
+        guard id >= 0 else { return false }
+        let bytes = Array(String(id).utf8)
+        var digest = [UInt8](repeating: 0, count: 64)
+        CC_SHA512(bytes, CC_LONG(bytes.count), &digest)
+        return digest.map { String(format: "%02x", $0) }.joined() == hash
+    }
+
+    // Cache identity only, never the database key. Revalidate against the live
+    // account hash so switching accounts cannot silently reuse an old identity.
+    static func resolveAccountUserId(
+        hash: String, cacheURL: URL, recover: (String) -> Int?
+    ) -> Int? {
+        if let data = try? Data(contentsOf: cacheURL),
+           let cached = try? JSONDecoder().decode(AccountCache.self, from: data),
+           cached.accountHash == hash, matchesAccount(cached.userId, hash: hash) {
+            return cached.userId
+        }
+        guard let id = recover(hash), matchesAccount(id, hash: hash) else { return nil }
+        do {
+            try FileManager.default.createDirectory(
+                at: cacheURL.deletingLastPathComponent(), withIntermediateDirectories: true,
+                attributes: [.posixPermissions: 0o700]
+            )
+            let data = try JSONEncoder().encode(AccountCache(accountHash: hash, userId: id))
+            try data.write(to: cacheURL, options: .atomic)
+            try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: cacheURL.path)
+        } catch {
+            // An unavailable cache must not prevent a verified identity being used.
+        }
+        return id
+    }
+
