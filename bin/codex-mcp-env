#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/.." && pwd -P)"
if [[ $# -lt 3 ]]; then
  echo "usage: codex-mcp-env HOST SECRET_NAME COMMAND [ARG ...]" >&2
  exit 2
fi

host_name="$1"
shift
if [[ ! "$host_name" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  echo "invalid host name: $host_name" >&2
  exit 2
fi

env_file="${CODEX_HELPER_ENV_FILE:-$repo_root/.env-$host_name}"
if [[ ! -f "$env_file" ]]; then
  echo "missing host environment file: $env_file" >&2
  exit 2
fi

# shellcheck disable=SC1090
source "$env_file"

secret_name="$1"
shift
if [[ ! "$secret_name" =~ ^[A-Z_][A-Z0-9_]*$ ]]; then
  echo "invalid secret name: $secret_name" >&2
  exit 2
fi

secret_value="${!secret_name-}"
if [[ -z "$secret_value" ]]; then
  echo "missing secret in $env_file: $secret_name" >&2
  exit 2
fi

exec "$@" "$secret_value"
