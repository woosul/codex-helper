#!/bin/sh
set -eu
SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  LINK=$(readlink "$SCRIPT")
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$SCRIPT_DIR/$LINK ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/.." && pwd)
exec uv run --with tomlkit==0.13.3 python "$ROOT/tools/harness.py" "$@"
